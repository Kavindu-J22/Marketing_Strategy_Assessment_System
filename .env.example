# ==============================================================================
# Environment Configuration Template (Team Stack Standardization)
# Marketing Strategy Assessment System (Consulting Framework Component)
# ==============================================================================

# Application Environment
PROJECT_NAME="Marketing Strategy Assessment System"
ENVIRONMENT=development # options: development, evaluation, production
LOG_LEVEL=INFO
DEBUG=true

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# Relational Database (Prisma Postgres / PostgreSQL) - Server-Side ONLY
# ------------------------------------------------------------------------------
# Pooled endpoint for application queries (PgBouncer/Prisma Accelerate)
DATABASE_URL=postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
# Direct endpoint for administrative schema migrations and DDL operations
DIRECT_URL=postgresql://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Generative AI & Embeddings (OpenAI API) - Server-Side ONLY
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-YOUR_ROTATED_OPENAI_API_KEY_HERE
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_GENERATION_MODEL=gpt-4o-mini
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# Vector Database (Pinecone Dense Vector Index) - Server-Side ONLY
# ------------------------------------------------------------------------------
PINECONE_API_KEY=pcsk_YOUR_ROTATED_PINECONE_API_KEY_HERE
PINECONE_INDEX_HOST=https://YOUR_INDEX_NAME-ID.svc.REGION.pinecone.io
PINECONE_INDEX_NAME=smart-tech-consulting-platform
PINECONE_NAMESPACE_PREFIX=staging-marketing
RAG_ENABLED=true

# ------------------------------------------------------------------------------
# Shared Team Authentication (Better Auth Service) - Server-Side ONLY
# ------------------------------------------------------------------------------
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=YOUR_ROTATED_BETTER_AUTH_SECRET_MIN_32_CHARS

# ------------------------------------------------------------------------------
# Document Storage (Optional Vercel Blob) - Server-Side ONLY
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_ROTATED_TOKEN_HERE

# ------------------------------------------------------------------------------
# Machine Learning Artifacts & Optimization Engine
# ------------------------------------------------------------------------------
MODEL_ARTIFACT_DIR=ml/artifacts
ML_DEVICE=cpu # options: cpu, cuda
DEFAULT_CLASSIFIER=fusion # options: rule, tfidf_lr, fusion
RANDOM_SEED=20261020

# ------------------------------------------------------------------------------
# Research Benchmark Datasets
# ------------------------------------------------------------------------------
DATASET_PATH=Dataset/Marketing_Questionnaire_Synthetic_5000.csv
ML_DATASET_PATH=Dataset/Audience_Classifier_ML_5000.csv
BUDGET_DATASET_PATH=Dataset/Marketing_Channel_Budget_5000.csv

# ------------------------------------------------------------------------------
# Legacy Compatibility Fallbacks (Optional)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
