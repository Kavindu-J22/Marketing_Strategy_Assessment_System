# ==============================================================================
# Environment Configuration Template
# Marketing Strategy Assessment System (Consulting Framework Component)
# ==============================================================================

# Application Environment
ENVIRONMENT=development # options: development, evaluation, production
LOG_LEVEL=INFO
DEBUG=true

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Persistence & Auth
# For local or cloud Supabase instance
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Backend server-side service key (NEVER expose to browser/frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# JWT secret for token signature verification
SUPABASE_JWT_SECRET=your-jwt-secret-at-least-32-chars-long

# LLM Feature-to-Value Service (Google Gemini) - Server Side ONLY
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_RETRIES=3

# Machine Learning Artifacts & Device
MODEL_ARTIFACT_DIR=ml/artifacts
ML_DEVICE=cpu # options: cpu, cuda
DEFAULT_CLASSIFIER=fusion # options: rule, tfidf_lr, fusion

# Research Evaluation & Seed
RANDOM_SEED=20261020
DATASET_PATH=Dataset/Marketing_Questionnaire_Synthetic_5000.csv
ML_DATASET_PATH=Dataset/Audience_Classifier_ML_5000.csv
BUDGET_DATASET_PATH=Dataset/Marketing_Channel_Budget_5000.csv
